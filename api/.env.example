DATABASE_URL=postgresql+asyncpg://sape:sape@localhost:5432/sape

MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=sape/+/telemetria

# Sem mensagem há mais que isso, o dispositivo aparece como offline
DEVICE_OFFLINE_AFTER_MIN=20
# Janela da regressão da taxa de elevação
RISE_RATE_WINDOW_MIN=60
